# po-extractor configuration. Copy to `.env` and adjust; `.env` is gitignored.
# Every variable is optional: the values shown are the defaults in app/core/settings.py.
# Real environment variables take precedence over values in `.env`.

# --- API ---------------------------------------------------------------------
# Interface and port the FastAPI server binds to.
API_HOST=127.0.0.1
API_PORT=8080

# --- App Redis (job queue, arq) ----------------------------------------------
# App Redis runs on 6380 so it never collides with Langfuse's own Redis.
REDIS_URL=redis://localhost:6380/0

# --- LiteLLM proxy -------------------------------------------------------------
# The app talks ONLY to LiteLLM; switching llama.cpp (Mac) <-> vLLM (H100) is done
# in the LiteLLM config, not here.
LITELLM_BASE_URL=http://localhost:4000
# LiteLLM master/virtual key. Leave empty if the proxy runs without auth.
LITELLM_API_KEY=

# --- Model aliases (must match model_name entries in the LiteLLM config) -----
# Fast path used for the optimised extraction.
PO_FAST=po-fast
# Stronger model used for escalation / re-asks.
PO_ACCURATE=po-accurate
# Naive single-call baseline (B0) used for evaluation.
PO_BASELINE=po-baseline

# --- Extraction limits ---------------------------------------------------------
# Global cap on concurrent in-flight LLM requests across all POs (must be > 0).
LLM_CONCURRENCY=32
# Targeted re-asks per PO after a validation failure (0 disables re-asks).
MAX_REASKS=1

# --- Langfuse (self-hosted tracing) --------------------------------------------
LANGFUSE_HOST=http://localhost:3000
# Project API keys from the Langfuse UI (Settings -> API Keys).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Storage -------------------------------------------------------------------
# Root for generated datasets, uploads and results (gitignored).
DATA_DIR=data
# SQLite database file for jobs and results.
SQLITE_PATH=data/po_extractor.db

# --- Logging -------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. Logs are JSON lines on stdout.
LOG_LEVEL=INFO
