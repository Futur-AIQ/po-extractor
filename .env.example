# po-extractor configuration. Copy to `.env` and adjust; `.env` is gitignored.
# Every variable is optional: the values shown are the defaults in app/core/settings.py.
# Real environment variables take precedence over values in `.env`.

# --- API ---------------------------------------------------------------------
# Interface and port the FastAPI server binds to.
API_HOST=127.0.0.1
API_PORT=8080

# --- App Redis (job queue, arq) ----------------------------------------------
# App Redis runs on 6380 so it never collides with Langfuse's own Redis.
REDIS_URL=redis://localhost:6380/0

# --- LiteLLM proxy -------------------------------------------------------------
# The app talks ONLY to LiteLLM; switching llama.cpp (Mac) <-> vLLM (H100) is done
# in the LiteLLM config, not here.
LITELLM_BASE_URL=http://localhost:4000
# REQUIRED. Used twice: the proxy's master key (infra/litellm/config.*.yaml read it via
# os.environ/LITELLM_API_KEY) and the bearer token the app sends. LiteLLM refuses to start
# if it is empty or the well-known "sk-1234". Generate one with:
#   echo "sk-$(openssl rand -hex 32)"
LITELLM_API_KEY=

# --- Local model (llama.cpp, Mac dev only) --------------------------------------
# Read by infra/llamacpp/start.sh (make model), not by the app. Hugging Face "repo:quant"
# form, passed to llama-server -hf and downloaded once into the llama.cpp cache.
# Project choice: unsloth/Qwen3.5-9B-GGUF:Q4_K_M (community quant; Qwen does not publish an
# official GGUF of Qwen3.5-9B). Tested with json_schema output and enable_thinking=false.
# Official-org alternative (~7-9B Qwen instruct, Q4_K_M): Qwen/Qwen3-8B-GGUF:Q4_K_M
LOCAL_GGUF=unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# Where llama-server listens. Only `make doctor` uses this; the app goes through LiteLLM.
LLAMACPP_BASE_URL=http://127.0.0.1:8081

# --- Model aliases (must match model_name entries in the LiteLLM config) -----
# Fast path used for the optimised extraction.
PO_FAST=po-fast
# Stronger model used for escalation / re-asks.
PO_ACCURATE=po-accurate
# Naive single-call baseline (B0) used for evaluation.
PO_BASELINE=po-baseline

# --- Extraction limits ---------------------------------------------------------
# Global cap on concurrent in-flight LLM requests across all POs (must be > 0).
LLM_CONCURRENCY=32
# Targeted re-asks per PO after a validation failure (0 disables re-asks).
MAX_REASKS=1

# --- Pre-processing --------------------------------------------------------------
# A page is "native" when its text layer has more than this many letters/digits;
# otherwise it is "scanned" (decided per page, so one PDF can mix both).
NATIVE_MIN_CHARS=50
# Page images sent to the model: resolution, format (jpeg | png), JPEG quality, and a cap
# on the longest side in pixels (guards against huge pages).
IMAGE_DPI=150
IMAGE_FORMAT=jpeg
IMAGE_JPEG_QUALITY=92
MAX_IMAGE_PX=2400
# Skip native pages that are only terms and conditions (never page 1, never scanned pages).
SKIP_FIELDLESS_PAGES=true
# What a native page sends to the model: text+image (default), text or image (ablations).
NATIVE_MODE=text+image
# Text layer of native pages: pymupdf (plain text in reading order, default) or
# pymupdf4llm (markdown tables; slower and longer, kept for ablations).
TEXT_ENGINE=pymupdf

# --- Langfuse (self-hosted tracing) --------------------------------------------
# Tracing is disabled while either key is empty; the app still runs normally.
# To get the keys (details: infra/langfuse/README.md):
#   1. make langfuse-up, then open http://localhost:3000
#   2. Sign up (first user), create an organisation, then a project
#   3. Project Settings -> API Keys -> Create new API keys
#   4. Paste the public key (pk-lf-...) and secret key (sk-lf-...) below, in .env
#   5. Check: uv run python -m scripts.smoke_trace
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Storage -------------------------------------------------------------------
# Root for generated datasets, uploads and results (gitignored).
DATA_DIR=data
# Extraction runs written by the baseline / optimised pipelines for evaluation (gitignored).
RUNS_DIR=runs
# SQLite database file for jobs and results.
SQLITE_PATH=data/po_extractor.db

# --- Logging -------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR. Logs are JSON lines on stdout.
LOG_LEVEL=INFO
